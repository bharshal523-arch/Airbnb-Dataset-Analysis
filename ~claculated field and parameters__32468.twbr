      <aliases enabled='yes' />
      <column caption='Beds (Airbnb listings.csv)' datatype='integer' name='[Beds (Airbnb_listings.csv)]' role='measure' type='quantitative' />
      <column datatype='integer' hidden='true' name='[Beds]' role='measure' type='quantitative' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0484088463491073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews] * [Review Scores Rating]' />
      </column>
      <column caption='Categorize Properties by Pricing' datatype='string' name='[Calculation_0484088463908866]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 300 THEN &quot;Luxury&quot;&#13;&#10;ELSEIF [Price] &gt;= 150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Identify Highly Reviewed Listings' datatype='string' name='[Calculation_0484088464318467]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews] &gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE &quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Create Availability Status' datatype='string' name='[Calculation_0484088464560132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;= TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0484088474796041]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0484088469573640]&#13;&#10;THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;Below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Host_Since' datatype='date' name='[Calculation_2231213140717569]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IFNULL([Host Since],DATE(&quot;01-01-2010&quot;))' />
      </column>
      <column caption='Updated_Neighbourhood' datatype='string' name='[Calculation_2231213142020098]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([Neighbourhood], &quot;Unknown&quot;)' />
      </column>
      <column caption='Review Score Rating (bin)' datatype='string' name='[Calculation_2231213142781955]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL(STR([Review Scores Rating (bin)]), &quot;NOT RATED&quot;)' />
      </column>
      <column caption='Updated_Beds' datatype='integer' name='[Calculation_2231213143375876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Beds], 0)' />
      </column>
